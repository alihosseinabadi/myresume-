# ══════════════════════════════════════════════════════════
#  MyResume — environment template
#  Copy to `.env` (gitignored) and fill in what you have.
#  NOTHING here is required: with no keys the backend runs
#  on the deterministic offline engine (AI_PROVIDER=auto
#  falls back to `local`).
# ══════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────
APP_NAME=MyResume API
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated origins allowed to call the API (the landing page)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_PATH=data/myresume.db

# ── AI provider chain ─────────────────────────────────────
# auto = first configured provider wins, in this order:
#        openrouter → groq → gemini → mistral → cerebras → ollama → local
# Force one with: openrouter | groq | gemini | mistral | cerebras | ollama | local
AI_PROVIDER=auto
AI_TIMEOUT_SECONDS=45
AI_MAX_TOKENS=1200
AI_TEMPERATURE=0.6

# OpenRouter (https://openrouter.ai/keys) — free models available
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Groq (https://console.groq.com/keys) — very fast
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google AI Studio / Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Mistral (https://console.mistral.ai/keys)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Cerebras (https://cloud.cerebras.ai)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.3-70b

# Ollama — local, free forever (https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── Job-link import (scraper engine chain) ────────────────
# Order is tried left to right; the first engine that returns a page wins.
#   scrapegraph → ScrapeGraphAI (hosted API or OSS library + local LLM)
#   playwright  → headless Chromium, for JavaScript-heavy boards
#   reader      → markdown reader proxy, no key needed
#   http        → plain request + JSON-LD/meta parsing (always available)
SCRAPE_ENGINES=scrapegraph,playwright,reader,http
SCRAPE_TIMEOUT_SECONDS=20

# ScrapeGraphAI hosted API — no library, no browser, billed per credit.
# Get a key at https://dashboard.scrapegraphai.com
SCRAPEGRAPH_ENABLED=true
SCRAPEGRAPH_API_KEY=
# …or the self-hosted OSS library (pip install -r requirements-scraper.txt)
# with a local LLM: ollama pull llama3
SCRAPEGRAPH_LLM_MODEL=ollama/llama3

# Playwright (pip install playwright && playwright install chromium)
SCRAPE_PLAYWRIGHT_ENABLED=true
# Reader proxy (https://r.jina.ai) — nothing to install
SCRAPE_READER_ENABLED=true

# ── Product ───────────────────────────────────────────────
FREE_RESUME_LIMIT=2
DEFAULT_LOCALE=en

# ── Landing page (landing/.env.local) ─────────────────────
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
